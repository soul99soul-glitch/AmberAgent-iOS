<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Registered by DesktopGateway via SMAppService.agent; the binary is embedded next to Amber. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>app.amber.macos.gateway</string>
    <key>BundleProgram</key><string>Contents/MacOS/amber-gateway</string>
    <key>ProgramArguments</key><array><string>amber-gateway</string><string>daemon</string></array>
    <key>AssociatedBundleIdentifiers</key><array><string>app.amber.macos</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
</dict>
</plist>
