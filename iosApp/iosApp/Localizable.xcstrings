          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창작"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создание"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "創作"
          }
        }
      }
    },
    "创作偏长文与文风；剧情同步偏稳定与结构化输出；审稿用来核对是否按计划写、前后是否打架。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use longer-form prose and style for writing; use stable, structured output for plot sync; use review to check whether the plan was followed and the story stays consistent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "創作では長文と文体を重視します。ストーリー同期では安定性と構造化された出力を重視し、レビューでは計画どおりか、前後に矛盾がないかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창작은 긴 글과 문체를 중심으로 하고, 줄거리 동기화는 안정적이고 구조화된 출력을 지향합니다. 검토는 계획대로 작성되었는지, 앞뒤 내용이 충돌하지 않는지 확인하는 데 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим создания рассчитан на длинный текст и стиль; синхронизация сюжета — на стабильный структурированный вывод; редактор проверяет соответствие плану и отсутствие противоречий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创作偏长文与文风；剧情同步偏稳定与结构化输出；审稿用来核对是否按计划写、前后是否打架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "創作偏長文與文風；劇情同步偏穩定與結構化輸出；審稿用來核對是否依計畫撰寫、前後是否衝突。"
          }
        }
      }
    },
