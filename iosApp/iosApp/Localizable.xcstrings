        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム議会に入り、異なる議席を招いて順番に議論します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 의회에 들어가 서로 다른 좌석을 초대해 차례로 논의하세요."
          }
        },
        "ru": {
