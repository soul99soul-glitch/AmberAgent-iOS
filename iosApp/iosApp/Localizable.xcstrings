        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のモジュールを生成できませんでした：%@。再生成では、これらの欠落した段落だけを再実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 모듈을 생성하지 못했습니다: %@. 다시 생성하면 누락된 단락만 다시 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сгенерировать следующие модули: %@. Повторная генерация запустит только эти пропущенные фрагменты."
          }
        },
