      }
    },
    "默认关闭。开启后 DeepSeek Flash 等会先思考再出 JSON，通常更慢。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When enabled, DeepSeek Flash and similar models think before returning JSON, which is usually slower."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトではオフです。オンにすると DeepSeek Flash などは JSON を出力する前に推論するため、通常は時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 꺼져 있습니다. 켜면 DeepSeek Flash 등이 먼저 추론한 후 JSON을 출력하므로 보통 더 느립니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию отключено. После включения DeepSeek Flash и другие модели сначала обдумывают ответ, а затем выдают JSON; обычно это медленнее."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后 DeepSeek Flash 等会先思考再出 JSON，通常更慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。開啟後 DeepSeek Flash 等模型會先思考再輸出 JSON，通常較慢。"
          }
        }
      }
    },
