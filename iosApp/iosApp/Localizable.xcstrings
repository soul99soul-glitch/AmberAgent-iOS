      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App restarted while waiting for confirmation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認待ちの間に App が再起動しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 대기 중 App이 재시작되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение перезапущено во время ожидания подтверждения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App restarted while waiting for confirmation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待確認時 App 已重新啟動。"
          }
