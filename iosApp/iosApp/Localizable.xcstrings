          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime по умолчанию"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 Runtime"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設 Runtime"
          }
        }
      }
    },
    "默认 Runtime 只影响前台测试和 Remote SSH 命令；聊天里的 iSH 工具在下方单独控制。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default Runtime affects only foreground tests and Remote SSH commands; the iSH tool in chat is controlled separately below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの Runtime はフォアグラウンドでのテストと Remote SSH コマンドにのみ影響します。チャットの iSH ツールは下で個別に管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 Runtime은 포그라운드 테스트와 Remote SSH 명령에만 영향을 주며, 채팅의 iSH 도구는 아래에서 별도로 제어합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime по умолчанию влияет только на проверку на переднем плане и команды Remote SSH; инструменты iSH в чате настраиваются отдельно ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 Runtime 只影响前台测试和 Remote SSH 命令；聊天里的 iSH 工具在下方单独控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設 Runtime 只會影響前景測試和 Remote SSH 命令；聊天中的 iSH 工具可在下方個別控制。"
          }
        }
      }
    },
    "默认 Runtime 只影响前台测试和远程命令入口；聊天里的 iSH 工具是否暴露，由下方 Agent 工具能力和权限闸门决定。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Runtime only affects foreground tests and remote command entry points; whether iSH tools are exposed in chat is determined by the Agent tool capabilities and permission gate below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト Runtime は前面表示中のテストとリモートコマンドの入口にのみ影響します。チャットで iSH ツールを公開するかどうかは、下の Agent ツール機能と権限ゲートで決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 Runtime은 포그라운드 테스트와 원격 명령 진입점에만 영향을 줍니다; 채팅에서 iSH 도구를 노출할지는 아래 Agent 도구 기능과 권한 게이트가 결정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime по умолчанию влияет только на проверки на переднем плане и вход для удалённых команд; доступность инструмента iSH в чате определяется возможностями инструментов Agent и барьером разрешений ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 Runtime 只影响前台测试和远程命令入口；聊天里的 iSH 工具是否暴露，由下方 Agent 工具能力和权限闸门决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設 Runtime 只影響前景測試與遠端命令入口；聊天中的 iSH 工具是否公開，由下方 Agent 工具能力與權限閘門決定。"
          }
        }
      }
    },
    "默认全选。文风方向来自「整章润色偏好」。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select all by default. The writing style comes from “Full-Chapter Polish Preferences.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトですべて選択されます。文体の方向性は「章全体の推敲設定」に基づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 모두 선택됩니다. 문체 방향은 「장 전체 다듬기 기본 설정」에서 가져옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выбраны все. Стиль берётся из «Предпочтений редактирования всей главы»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认全选。文风方向来自「整章润色偏好」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設全選。文風方向來自「整章潤飾偏好」。"
          }
        }
      }
    },
    "默认关闭": {
      "extractionState": "manual",
      "localizations": {
