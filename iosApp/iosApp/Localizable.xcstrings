    "%@ 可继续讨论；写正文前请先重试同步。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can still be discussed; retry sync before writing the manuscript."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 引き続き相談できます。本文を書く前に同期を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 계속 논의할 수 있습니다. 본문을 쓰기 전에 동기화를 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Можно продолжить обсуждение; перед написанием текста повторите синхронизацию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可继续讨论；写正文前请先重试同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 可繼續討論；寫正文前請先重試同步。"
          }
        }
      }
    },
