          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За один раз можно прикрепить не более %lld файлов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多附加 %lld 个文件"
          }
        },
