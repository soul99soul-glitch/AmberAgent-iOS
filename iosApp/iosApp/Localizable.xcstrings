        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生未完成，部分內容可能不完整。點右上角重試。"
          }
        }
      }
    },
    "生成结束后才能导出项目包；正文和工作区仍可导出。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project package can be exported only after generation finishes; the manuscript and workspace can still be exported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成が完了してからプロジェクトパッケージをエクスポートできます。本文とワークスペースは引き続きエクスポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성이 끝난 후에만 프로젝트 패키지를 내보낼 수 있습니다. 본문과 작업 공간은 계속 내보낼 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет проекта можно экспортировать только после завершения генерации; текст и Workspace можно экспортировать и раньше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成结束后才能导出项目包；正文和工作区仍可导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生結束後才能匯出專案套件；正文和工作區仍可匯出。"
          }
        }
      }
    },
