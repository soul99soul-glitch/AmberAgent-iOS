{
  "schema": "amber.plugin.v3",
  "manifest_version": 3,
  "id": "netease-music",
  "name": "网易云音乐",
  "version": "3.0.0",
  "description": "通过网易云官方 ncm-cli 搜索、选歌并控制本机播放器。",
  "icon": "music.note",
  "permissions": ["ui.views", "music.netease", "http:music.126.net", "http:music.163.com"],
  "ui": {
    "views": [
      {"id": "netease_player", "title": "网易云音乐", "slot": "workspace", "symbol": "music.note", "subtitle": "搜索歌曲并控制本机播放", "entry": "index.html"},
      {"id": "netease_player_sidebar", "title": "网易云音乐", "slot": "right_sidebar", "symbol": "music.note", "entry": "index.html", "aspect_ratio": 1, "compact_height": 60}
    ]
  }
}
