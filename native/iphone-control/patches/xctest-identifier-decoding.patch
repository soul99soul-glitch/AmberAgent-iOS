+#[cfg(test)]
+mod identifier_tests {
+    use super::*;
+
+    fn archived_identifier() -> Vec<u8> {
+        let uid = |index| Value::Uid(plist::Uid::new(index));
+        let objects = vec![
+            Value::String("$null".into()),
+            Value::Dictionary(crate::plist!(dict {
+                "$class": uid(2), "c": uid(3), "o": 2u64,
+            })),
+            Value::Dictionary(crate::plist!(dict {
+                "$classname": "XCTTestIdentifier",
+                "$classes": vec!["XCTTestIdentifier", "NSObject"],
+            })),
+            Value::Dictionary(crate::plist!(dict {
+                "$class": uid(4), "NS.objects": vec![uid(5), uid(6)],
+            })),
+            Value::Dictionary(crate::plist!(dict {
+                "$classname": "NSArray", "$classes": vec!["NSArray", "NSObject"],
+            })),
+            Value::String("iPhoneUse.RunnerTests".into()),
+            Value::String("testServe".into()),
+        ];
+        let archive = Value::Dictionary(crate::plist!(dict {
+            "$archiver": "NSKeyedArchiver", "$version": 100000u64,
+            "$top": crate::plist!(dict { "root": uid(1), }), "$objects": objects,
+        }));
+        let mut bytes = Vec::new();
+        archive.to_writer_binary(&mut bytes).unwrap();
+        bytes
+    }
+
+    fn configuration() -> XCTestConfiguration {
+        XCTestConfiguration {
+            test_bundle_url: "file:///Runner.app/PlugIns/iPhoneUse.xctest".into(),
+            session_identifier: uuid::Uuid::nil(),
+            product_module_name: "iPhoneUse".into(),
+            automation_framework_path: "/System/Developer/Library/PrivateFrameworks/XCTAutomationSupport.framework".into(),
+            target_application_bundle_id: None,
+            target_application_path: None,
+            target_application_environment: None,
+            target_application_arguments: Vec::new(),
+            tests_to_run: None,
+            tests_to_skip: None,
+            ide_capabilities: XCTCapabilities::ide_defaults(),
+        }
+    }
+
+    #[derive(Default)]
+    struct Listener {
+        starts: Vec<(String, String)>,
+        finishes: Vec<XCTestCaseResult>,
+    }
+
+    impl XCUITestListener for Listener {
+        async fn test_case_did_start(&mut self, class: &str, method: &str) -> Result<(), IdeviceError> {
+            self.starts.push((class.into(), method.into()));
+            Ok(())
+        }
+
+        async fn test_case_did_finish(&mut self, result: XCTestCaseResult) -> Result<(), IdeviceError> {
+            self.finishes.push(result);
+            Ok(())
+        }
+    }
+
+    #[tokio::test]
+    async fn identifier_archive_dispatches_test_case_start() {
+        let mut listener = Listener::default();
+        let mut done = false;
+        dispatch_xct_message(
+            XCT_CASE_DID_START_ID,
+            &[AuxValue::Array(archived_identifier())],
+            &configuration(),
+            &mut listener,
+            &mut done,
+        ).await.unwrap();
+        assert_eq!(listener.starts, vec![("iPhoneUse.RunnerTests".into(), "testServe".into())]);
+        assert!(!done);
+    }
+
+    #[tokio::test]
+    async fn identifier_archive_dispatches_test_case_finish() {
+        let mut listener = Listener::default();
+        dispatch_xct_message(
+            XCT_CASE_DID_FINISH_ID,
+            &[
+                AuxValue::Array(archived_identifier()),
+                AuxValue::String("passed".into()),
+                AuxValue::Double(0.25),
+            ],
+            &configuration(),
+            &mut listener,
+            &mut false,
+        ).await.unwrap();
+        assert_eq!(listener.finishes.len(), 1);
+        let result = &listener.finishes[0];
+        assert_eq!(result.test_class, "iPhoneUse.RunnerTests");
+        assert_eq!(result.method, "testServe");
+        assert_eq!(result.status, "passed");
+        assert_eq!(result.duration, 0.25);
+    }
+
+    #[test]
+    fn identifier_archive_rejects_invalid_references_and_types() {
+        let uid = |index| Value::Uid(plist::Uid::new(index));
+        for (index, key, value) in [
+            (1, "c", uid(99)),
+            (1, "c", uid(1)),
+            (1, "c", Value::Integer(3u64.into())),
+            (2, "$classname", Value::String("OtherClass".into())),
+            (3, "NS.objects", Value::Array(vec![uid(5), uid(99)])),
+            (3, "NS.objects", Value::Array(vec![uid(5), uid(1)])),
+            (3, "NS.objects", Value::Array(Vec::new())),
+            (4, "$classname", Value::String("NSDictionary".into())),
+        ] {
+            let mut archive = Value::from_reader(std::io::Cursor::new(archived_identifier())).unwrap();
+            let objects = archive.as_dictionary_mut().unwrap()
+                .get_mut("$objects").unwrap().as_array_mut().unwrap();
+            objects[index].as_dictionary_mut().unwrap().insert(key.into(), value);
+            let mut bytes = Vec::new();
+            archive.to_writer_binary(&mut bytes).unwrap();
+            assert!(decode_aux_identifier(&AuxValue::Array(bytes)).is_none(), "object {index}, key {key}");
+        }
+        assert!(decode_aux_identifier(&AuxValue::Array(vec![0])).is_none());
+        assert!(decode_aux_identifier(&AuxValue::U32(1)).is_none());
+    }
+}
